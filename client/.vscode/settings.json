{
  "css.validate": false,
  "scss.validate": false,
  "tailwindCSS.includeLanguages": {
    "scss": "css",
    "html": "html",
    "typescript": "javascript"
  },
  "editor.quickSuggestions": {
    "strings": true
  },
  "files.associations": {
    "*.css": "tailwindcss",
    "*.scss": "tailwindcss"
  },
  "tailwindCSS.rootFontSize": 16,
  "tailwindCSS.experimental.configFile": "client/tailwind.config.js"
}