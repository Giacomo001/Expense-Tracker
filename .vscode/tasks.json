{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/API/ExpenseTracker.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ng serve",
      "command": "ng",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "args": [
        "serve",
        "--host", "0.0.0.0",
        "--poll", "2000"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^ERROR in (.*)$",
          "file": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Re-optimizing dependencies",
          "endsPattern": "Local:\\s+http://localhost:4200"
        }
      }
    }
  ]
}
