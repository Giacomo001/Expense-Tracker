FROM mcr.microsoft.com/dotnet/sdk:10.0

RUN apt-get update && apt-get install -y make curl sudo openssh-client postgresql-client && rm -rf /var/lib/apt/lists/*

# Node.js 20 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Create developer user with UID/GID 1000 idempotently
RUN EXISTING_USER=$(getent passwd 1000 | cut -d: -f1) \
    && EXISTING_GROUP=$(getent group 1000 | cut -d: -f1) \
    && if [ -n "$EXISTING_GROUP" ] && [ "$EXISTING_GROUP" != "developer" ]; then \
         groupmod -n developer "$EXISTING_GROUP"; \
       elif [ -z "$EXISTING_GROUP" ]; then \
         groupadd --gid 1000 developer; \
       fi \
    && if [ -n "$EXISTING_USER" ] && [ "$EXISTING_USER" != "developer" ]; then \
         usermod -l developer -d /home/developer -m "$EXISTING_USER"; \
       elif [ -z "$EXISTING_USER" ]; then \
         useradd --uid 1000 --gid 1000 -m developer; \
       fi \
    && echo "developer ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/developer \
    && chmod 0440 /etc/sudoers.d/developer \
    && mkdir -p /workspace \
    && chown -R developer:developer /workspace

# Global tools installed as root
RUN curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg
RUN npm install -g @angular/cli --ignore-scripts

ENV DOTNET_USE_POLLING_FILE_WATCHER=1
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV ASPNETCORE_ENVIRONMENT=Development
ENV ASPNETCORE_URLS=http://+:8080

# dotnet tools installed as developer
USER developer
RUN dotnet tool install --global dotnet-ef
ENV PATH="$PATH:/home/developer/.dotnet/tools"

WORKDIR /workspace

EXPOSE 8080
CMD ["sleep", "infinity"]